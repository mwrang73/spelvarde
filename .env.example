# Spelvärde – miljövariabler. Kopiera till .env (lokalt) eller sätt i Vercel.

# Databasen: ett EGET schema "spelvarde" i Tabellgissningens Supabase-projekt.
# Båda adresserna MÅSTE sluta på schema=spelvarde, annars hamnar Prismas
# migreringstabell i public och krockar med Tabellgissningens.
# Drift (Supabase pooler; samma värd och användare som Tabellgissningen):
#   DATABASE_URL="postgresql://postgres.PROJECT-REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=spelvarde"
#   DIRECT_URL="postgresql://postgres.PROJECT-REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?schema=spelvarde"
# Lokalt (npm run db:local):
DATABASE_URL="postgresql://spelvarde:spelvarde@127.0.0.1:54329/spelvarde_dev?schema=spelvarde"
DIRECT_URL="postgresql://spelvarde:spelvarde@127.0.0.1:54329/spelvarde_dev?schema=spelvarde"

# Obligatorisk: signeringsnyckel för inloggningen (JWT). Generera med
# `openssl rand -base64 32`. Eget värde för Spelvärde, inte Tabellgissningens.
AUTH_SECRET="ändra-mig-till-en-slumpad-hemlighet"

# Skyddar /api/cron/* (byggs i E3 och E4). Vercel skickar den som Bearer-token.
CRON_SECRET=""

# Seed (scripts/seed.mjs): Mikael som enda användare med rollen ADMIN.
# Lösenordet minst 10 tecken. Behövs bara när seed körs, inte av appen.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Mikael"

# Bara lokalt: läs ATG och/eller travstatistik.se från test/fixtures i stället
# för nätet. "atg,ts", "atg" eller "ts". Ignoreras på Vercel.
# SPELVARDE_FIXTURES="ts"

# Från E5: ANTHROPIC_API_KEY="" (Hämta tips).
