// Spelvärde – datamodell för hela appen (specen avsnitt 8).
//
// Databasen är ett EGET schema, "spelvarde", i Tabellgissningens
// Supabase-projekt. Två saker håller isär apparna:
//   1. multiSchema + @@schema("spelvarde") på varje modell och enum gör att
//      all SQL som Prisma genererar är fullt kvalificerad ("spelvarde"."X").
//   2. ?schema=spelvarde i DATABASE_URL och DIRECT_URL gör att Prismas egen
//      migreringstabell (_prisma_migrations) också ligger i spelvarde, och
//      inte blandas ihop med Tabellgissningens i public.
// Kör bara `prisma migrate deploy` mot drift, aldrig `migrate dev`/`reset`.
//
// Gemensamt (ATG-fakta): Round, Race, Horse, Person, PersonAlias, Start,
// HorseRecord, RoundSnapshot, StreckValue, StatsSnapshot, ModelVersion,
// Riktodds, FetchLog. Skrivs bara av hämtning, synk och cron.
// Per användare: UserSettings, Mark, RaceReview, HorseComment, Coupon,
// LiveAlarm, Outcome, Source, TipFact. Har alltid userId från sessionen.
//
// Tider i UTC. Odds och procent som Decimal(6,2). Villkor som Prisma inte kan
// uttrycka (check, delvisa unika index) ligger i migreringens SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["spelvarde"]
}

enum Role {
  USER
  ADMIN

  @@schema("spelvarde")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("spelvarde")
}

enum ThemeChoice {
  SYSTEM
  LIGHT
  DARK

  @@schema("spelvarde")
}

enum FetchStatus {
  COMPLETE
  PARTIAL
  FAILED

  @@schema("spelvarde")
}

enum StartMethod {
  AUTO
  VOLTE

  @@schema("spelvarde")
}

enum SnapshotKind {
  BASELINE
  LIVE
  FETCH

  @@schema("spelvarde")
}

enum AliasSource {
  TRAVSTATISTIK

  @@schema("spelvarde")
}

enum SpelbarOverride {
  NONE
  ON
  OFF

  @@schema("spelvarde")
}

// X-faktor (6.8, E2.1): Ingen, Tror på, Stark känsla.
enum XFactor {
  NONE
  TROR
  STARK

  @@schema("spelvarde")
}

// Källan till Mark.unibetOdds (E2.2): inskrivet av användaren eller hämtat.
enum OddsSource {
  MANUAL
  UNIBET

  @@schema("spelvarde")
}

enum CommentKind {
  NOTE
  RACE

  @@schema("spelvarde")
}

enum AlarmKind {
  RUSH
  DROP

  @@schema("spelvarde")
}

enum TipKind {
  FACT
  PATTERN

  @@schema("spelvarde")
}

// ---- Hämta tips (E5, docs/specs/e5-hamta-tips.md 8.4) ----

// Rollen som tipset ger hästen (6.11). Starkast först.
enum TipRole {
  SPIK
  FAVORIT
  SKRALL
  AVRADAN
  NAMND

  @@schema("spelvarde")
}

enum TipReview {
  PENDING // att granska
  APPROVED // godkänt, syns och räknas (om supersededById är null)
  REJECTED // borttaget av användaren

  @@schema("spelvarde")
}

enum TipMatch {
  SURE
  UNSURE
  NONE // ej kopplat

  @@schema("spelvarde")
}

enum TipStage {
  EARLY
  FINAL

  @@schema("spelvarde")
}

enum TipArticleStatus {
  NEW // läst, inte tolkad (eller texten har ändrats)
  INTERPRETED // tolkad, interpretedHash = textHash
  FAILED // senaste tolkningen misslyckades
  DUPLICATE // samma text som en annan artikel, tolkas inte

  @@schema("spelvarde")
}

enum SourceKind {
  COLLECTION // samlingssida: följ länkarna (Travstugan)
  PAGE // läs sidan direkt som en artikel

  @@schema("spelvarde")
}

// ---------------------------------------------------------------------------
// Användare

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  settings      UserSettings?
  marks         Mark[]
  reviews       RaceReview[]
  comments      HorseComment[]
  coupons       Coupon[]
  alarms        LiveAlarm[]
  outcomes      Outcome[]
  sources       Source[]
  tipFacts      TipFact[]
  fetchLogs     FetchLog[]
  modelVersions ModelVersion[]
  oddsFetches   OddsFetch[]
  tipArticles   TipArticle[]
  tips          Tip[]
  aiUsages      AiUsage[]

  @@schema("spelvarde")
}

model UserSettings {
  userId           String      @id
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            ThemeChoice @default(SYSTEM)
  rushThresholdPe  Decimal     @default(10.0) @db.Decimal(6, 2)
  rowPrice         Decimal     @default(0.50) @db.Decimal(6, 2)
  spelbarGuideline Decimal     @default(2.00) @db.Decimal(6, 2)
  // X-faktorerna (6.8, E2.1). 1,05–3,00 och Stark > Tror (check i migreringen).
  xFactorTror      Decimal     @default(1.25) @db.Decimal(4, 2)
  xFactorStark     Decimal     @default(1.50) @db.Decimal(4, 2)
  // E2.2 (6.1): hur mycket under riktoddset med X-faktor Unibet-oddset får
  // ligga och ändå föreslås som Spelbar. 0,00–0,50 (check i migreringen).
  spelbarTolerance Decimal     @default(0.10) @db.Decimal(4, 2)
  // Spelformen som Hämta omgång letar efter: V75, V85, V86 eller GS75 (lib/game-type.ts).
  gameType         String      @default("V85")
  updatedAt        DateTime    @updatedAt

  @@schema("spelvarde")
}

// ---------------------------------------------------------------------------
// Gemensamt: ATG-data

model Round {
  id           String      @id @default(cuid())
  atgGameId    String      @unique
  // V75, V85, V86 eller GS75 (prefixet i atgGameId).
  gameType     String      @default("V85")
  // Omgångens lokala datum (lördag), utan tid.
  date         DateTime    @db.Date
  trackId      Int
  trackName    String
  firstStartAt DateTime
  atgStatus    String?
  fetchedAt    DateTime?
  fetchStatus  FetchStatus @default(PARTIAL)
  // Claim för livesynken (E3): den som sätter fältet hämtar från ATG.
  liveSyncAt   DateTime?
  liveOkAt     DateTime?
  baselineAt   DateTime?
  finishedAt   DateTime?
  // Räknas upp vid varje ändring av gemensam data, så att klienten vet när
  // hela omgången ska läsas om.
  rev          Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  races       Race[]
  snapshots   RoundSnapshot[]
  stats       StatsSnapshot[]
  fetchLogs   FetchLog[]
  comments    HorseComment[]
  coupons     Coupon[]
  outcomes    Outcome[]
  tipFacts    TipFact[]
  oddsFetches OddsFetch[]
  tipArticles TipArticle[]
  tips        Tip[]
  aiUsages    AiUsage[]

  @@index([date])
  @@schema("spelvarde")
}

model Race {
  id               String      @id @default(cuid())
  roundId          String
  round            Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  atgRaceId        String      @unique
  // Avdelning 1–8 i spelets ordning (7 för V75 och GS75).
  leg              Int
  // Loppnummer på banan.
  raceNumber       Int
  name             String
  startAt          DateTime
  scheduledStartAt DateTime?
  distance         Int
  startMethod      StartMethod
  // Förstapris i kr, tolkat ur prize-texten. Hela texten i prizeText.
  prize            Int?
  prizeText        String?
  classLabel       String?
  terms            String[]
  atgStatus        String?
  resultAt         DateTime?
  cancelled        Boolean     @default(false)
  // Steg 2–9: när alla starter i avdelningen senast hämtades utan fel.
  recordsFetchedAt DateTime?
  // E2.2 (10.5): loppets nyckel hos Unibet, t.ex. "202610241300.H.SWE.jagersro.5".
  // Sätts när en oddshämtning slår upp banan; läses av anropet per avdelning.
  unibetEventKey   String?
  // E4a (6.4): när frysningen av Outcome gjordes för loppet (första läsningen
  // efter starttiden). NULL = inte fryst än. Gör kontrollen i GET billig.
  outcomesFrozenAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  starts  Start[]
  reviews RaceReview[]

  @@unique([roundId, leg])
  @@schema("spelvarde")
}

model Horse {
  id         String   @id @default(cuid())
  atgHorseId Int      @unique
  name       String
  sex        String?
  birthYear  Int?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  starts   Start[]
  records  HorseRecord[]
  comments HorseComment[]
  tipFacts TipFact[]
  tips     Tip[]

  @@schema("spelvarde")
}

// Kusk eller tränare.
model Person {
  id          String    @id @default(cuid())
  atgPersonId Int       @unique
  firstName   String
  lastName    String
  shortName   String?
  location    String?
  // { "2026": { starts, wins, seconds, thirds, winPercentage, earnings }, … }
  statsJson   Json?
  statsAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  drivenStarts     Start[]       @relation("StartDriver")
  trainedStarts    Start[]       @relation("StartTrainer")
  prevDrivenStarts Start[]       @relation("StartPrevDriver")
  aliases          PersonAlias[]

  @@schema("spelvarde")
}

model PersonAlias {
  id        String      @id @default(cuid())
  source    AliasSource
  // Namnet som det står på källan, t.ex. "Kihlström Ö".
  rawName   String
  personId  String?
  person    Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([source, rawName])
  @@index([personId])
  @@schema("spelvarde")
}

model Start {
  id               String    @id @default(cuid())
  raceId           String
  race             Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horseId          String
  horse            Horse     @relation(fields: [horseId], references: [id], onDelete: Restrict)
  number           Int
  postPosition     Int?
  // Distans inklusive tillägg.
  distance         Int
  driverId         String?
  driver           Person?   @relation("StartDriver", fields: [driverId], references: [id], onDelete: SetNull)
  trainerId        String?
  trainer          Person?   @relation("StartTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  // Kusken före ett kuskbyte (vår egen jämförelse eller ATG:s originalDriver).
  prevDriverId     String?
  prevDriver       Person?   @relation("StartPrevDriver", fields: [prevDriverId], references: [id], onDelete: SetNull)
  scratched        Boolean   @default(false)
  scratchedAt      DateTime?
  age              Int?
  // T.ex. "1.11,8aM".
  record           String?
  // Hästens samlade vinstsumma i kr.
  earnings         Int?
  horseStatsJson   Json?
  shoes            Json?
  sulky            Json?
  lastFetchedAt    DateTime?
  recordsFetchedAt DateTime?
  // Senaste felet i steg 2–9 för just den här starten (tas om vid nästa försök).
  recordsError     String?
  // Resultat
  place            Int?
  finishOrder      Int?
  disqualified     Boolean   @default(false)
  galloped         Boolean   @default(false)
  kmTime           String?
  finalOdds        Decimal?  @db.Decimal(6, 2)
  // Platsodds vid resultat (ATG pools.plats min/max), för backtest.
  placeOddsMin     Decimal?  @db.Decimal(6, 2)
  placeOddsMax     Decimal?  @db.Decimal(6, 2)
  resultAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  streck       StreckValue[]
  riktodds     Riktodds[]
  marks        Mark[]
  comments     HorseComment[]
  alarms       LiveAlarm[]
  outcomes     Outcome[]
  tipFacts     TipFact[]
  unibetPrices UnibetPrice[]
  tips         Tip[]

  @@unique([raceId, horseId])
  @@unique([raceId, number])
  @@index([horseId])
  @@index([driverId])
  @@index([trainerId])
  @@index([prevDriverId])
  @@schema("spelvarde")
}

model HorseRecord {
  id           String       @id @default(cuid())
  horseId      String
  horse        Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  date         DateTime     @db.Date
  trackName    String
  trackId      Int?
  atgRaceRef   String?
  raceNumber   Int?
  distance     Int?
  startMethod  StartMethod?
  postPosition Int?
  place        Int?
  galloped     Boolean      @default(false)
  disqualified Boolean      @default(false)
  // Hästen var struken i loppet. Räknas inte som start.
  scratched    Boolean      @default(false)
  // "1.12,9" eller ATG:s kod ("u", "6" …) när tiden saknas.
  kmTime       String?
  odds         Decimal?     @db.Decimal(6, 2)
  driverName   String?
  firstPrize   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([horseId, date, trackName])
  @@index([horseId, date])
  @@schema("spelvarde")
}

model RoundSnapshot {
  id      String       @id @default(cuid())
  roundId String
  round   Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  takenAt DateTime     @default(now())
  kind    SnapshotKind

  values StreckValue[]

  @@index([roundId, kind, takenAt])
  @@schema("spelvarde")
}

model StreckValue {
  id         String        @id @default(cuid())
  snapshotId String
  snapshot   RoundSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  startId    String
  start      Start         @relation(fields: [startId], references: [id], onDelete: Cascade)
  // Hundradelar av procent (ATG betDistribution), 1234 = 12,34 %.
  value      Int

  @@unique([snapshotId, startId])
  @@index([startId])
  @@schema("spelvarde")
}

model StatsSnapshot {
  id        String   @id @default(cuid())
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Sidnyckel enligt 10.3: startnr, rank, ms, bana, kuskliga, tranarliga, form, senaste.
  source    String
  fetchedAt DateTime @default(now())
  ok        Boolean
  error     String?
  data      Json?

  @@index([roundId, source, fetchedAt])
  @@schema("spelvarde")
}

model ModelVersion {
  id          String   @id @default(cuid())
  key         String   @unique
  weights     Json
  params      Json
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  backtest    Json?

  riktodds Riktodds[]

  @@index([createdById])
  @@schema("spelvarde")
}

model Riktodds {
  id             String       @id @default(cuid())
  startId        String
  start          Start        @relation(fields: [startId], references: [id], onDelete: Cascade)
  modelVersionId String
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  probTop3       Decimal      @db.Decimal(8, 6)
  odds           Decimal      @db.Decimal(6, 2)
  uncertain      Boolean      @default(false)
  inputs         Json
  contributions  Json
  computedAt     DateTime     @default(now())

  @@unique([startId, modelVersionId])
  @@index([modelVersionId])
  @@schema("spelvarde")
}

model FetchLog {
  id         String    @id @default(cuid())
  roundId    String
  round      Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Null när ett cron-jobb hämtade.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // GAME, RACE_1 … RACE_8, STATS, RIKTODDS
  step       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  message    String?
  // { scratched: [...], driverChanges: [...] }
  changes    Json?

  @@index([roundId, startedAt])
  @@index([userId])
  @@schema("spelvarde")
}

// ---------------------------------------------------------------------------
// Unibets odds (E2.2, specen 8.3). Gemensam data som bara oddshämtningen
// skriver: ett huvud per tryck på Hämta streck och odds (oddsdelen) och en rad
// per start. En hämtning utan några odds tas bort i finish och sparas alltså
// inte. Spärren (högst en per omgång och 2 minuter) räknas från takenAt.

model OddsFetch {
  id          String    @id @default(cuid())
  roundId     String
  round       Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Den som tryckte (null om användaren har tagits bort).
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  takenAt     DateTime  @default(now())
  finishedAt  DateTime?
  // Avdelningar som Unibet svarade för, som misslyckades och som hoppades
  // över (loppet hade startat). Uppdateras per avdelning.
  legsOk      Int[]
  legsFailed  Int[]
  legsSkipped Int[]

  prices        UnibetPrice[]
  replacedMarks Mark[]

  @@index([roundId, takenAt])
  @@index([userId])
  @@schema("spelvarde")
}

model UnibetPrice {
  id        String    @id @default(cuid())
  fetchId   String
  fetch     OddsFetch @relation(fields: [fetchId], references: [id], onDelete: Cascade)
  startId   String
  start     Start     @relation(fields: [startId], references: [id], onDelete: Cascade)
  // FixedPlace och FixedWin, avrundade till hundradelar. NULL när hästen är
  // struken hos Unibet (eller saknar pris).
  placeOdds Decimal?  @db.Decimal(6, 2)
  winOdds   Decimal?  @db.Decimal(7, 2)
  // Unibets competitor.status: "Starter" = startar, annat = struken hos Unibet.
  status    String

  @@unique([fetchId, startId])
  @@index([startId])
  @@schema("spelvarde")
}

// ---------------------------------------------------------------------------
// Per användare

model Mark {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  startId           String
  start             Start           @relation(fields: [startId], references: [id], onDelete: Cascade)
  interesting       Boolean         @default(false)
  interestingAt     DateTime?
  spelbarOverride   SpelbarOverride @default(NONE)
  bet               Boolean         @default(false)
  betAt             DateTime?
  betOdds           Decimal?        @db.Decimal(6, 2)
  unibetOdds        Decimal?        @db.Decimal(6, 2)
  unibetOddsAt      DateTime?
  unibetOddsPrev    Decimal?        @db.Decimal(6, 2)
  // E2.1 (6.8): X-faktor (kräver Intressant) och källstöd 0–20 (null = inte ifyllt).
  xFactor           XFactor         @default(NONE)
  xFactorAt         DateTime?
  sourceSupport     Int?
  // E2.2 (8.3): källan till unibetOdds. NULL = inget odds. UNIBET med
  // unibetOdds = NULL = struken hos Unibet.
  unibetOddsSource  OddsSource?
  // Ångra (6.9): det egna oddset som hämtningen replacedByFetchId ersatte.
  replacedOdds      Decimal?        @db.Decimal(6, 2)
  replacedByFetchId String?
  replacedByFetch   OddsFetch?      @relation(fields: [replacedByFetchId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, startId])
  @@index([startId])
  @@index([replacedByFetchId])
  @@schema("spelvarde")
}

model RaceReview {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceId          String
  race            Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  reviewedAt      DateTime @default(now())
  noneInteresting Boolean  @default(false)

  @@unique([userId, raceId])
  @@index([raceId])
  @@schema("spelvarde")
}

model HorseComment {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  horseId   String
  horse     Horse       @relation(fields: [horseId], references: [id], onDelete: Cascade)
  startId   String?
  start     Start?      @relation(fields: [startId], references: [id], onDelete: SetNull)
  roundId   String?
  round     Round?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  kind      CommentKind
  tags      String[]
  text      String      @default("")
  // uuid som klienten skapar, så att en omsänd PUT inte ger dubbletter.
  clientId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@unique([userId, clientId])
  @@index([userId, horseId])
  @@index([horseId])
  @@index([startId])
  @@index([roundId])
  @@schema("spelvarde")
}

model Coupon {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  budget     Int
  rowPrice   Decimal  @db.Decimal(6, 2)
  // { "1": [3, 10], "2": [5], … }
  selections Json
  lockedLegs Int[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // E6 (docs/specs/e6-v85-rad.md 8.5). null = raden sparades före E6 (gammal
  // rad, visas som den är). Databasen har villkoren spikCount 0–8 och allgLeg 1–8.
  spikCount        Int?
  allgMode         AllgMode?
  // CHOSEN: Mikaels val. AUTO: den avdelning appen valde vid senaste sparningen.
  allgLeg          Int?
  // Skälen per avdelning och häst vid senaste sparningen (legRoles version 1).
  legRoles         Json?
  // Senaste Kopiera texten och raden som kopierades då.
  copiedAt         DateTime?
  copiedSelections Json?

  @@unique([userId, roundId])
  @@index([roundId])
  @@schema("spelvarde")
}

// E6: allgarderingens läge. Ingen NONE (spec 8.5); läggs till med ALTER TYPE … ADD VALUE vid behov.
enum AllgMode {
  AUTO
  CHOSEN

  @@schema("spelvarde")
}

model LiveAlarm {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startId      String
  start        Start     @relation(fields: [startId], references: [id], onDelete: Cascade)
  kind         AlarmKind
  firstSeenAt  DateTime  @default(now())
  deltaAtFirst Decimal   @db.Decimal(6, 2)
  lastDelta    Decimal   @db.Decimal(6, 2)
  ackAt        DateTime?
  rearmedAt    DateTime?

  @@index([userId, startId, kind])
  @@index([startId])
  @@schema("spelvarde")
}

model Outcome {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startId          String
  start            Start    @relation(fields: [startId], references: [id], onDelete: Cascade)
  roundId          String
  round            Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  interesting      Boolean
  spelbar          Boolean
  bet              Boolean
  unibetOdds       Decimal? @db.Decimal(6, 2)
  betOdds          Decimal? @db.Decimal(6, 2)
  riktodds         Decimal? @db.Decimal(6, 2)
  // E2.1 (6.8). Skrivs av frysningen i E4 med värdena vid loppets start:
  // xFactor från Mark, xFactorValue = användarens faktor då (1,00 för NONE),
  // riktoddsX = riktoddset med X-faktor, sourceSupport från Mark och
  // sourceTotal = antal påslagna källor då.
  xFactor          XFactor  @default(NONE)
  xFactorValue     Decimal  @default(1.00) @db.Decimal(4, 2)
  riktoddsX        Decimal? @db.Decimal(6, 2)
  sourceSupport    Int?
  sourceTotal      Int?
  frozenAt         DateTime @default(now())
  place            Int?
  disqualified     Boolean  @default(false)
  hit              Boolean?
  // E4a (avsnitt 18): Trollspöt precis före loppets start, räknat med
  // trollspot(races, startAt − 1 ms, tolerans). Plats 1–10 i listan, minst X
  // och det uppskattade platsoddset. Alla NULL när hästen inte var med.
  trollspotRank    Int?
  trollspotMinOdds Decimal? @db.Decimal(6, 2)
  trollspotEstOdds Decimal? @db.Decimal(6, 2)

  @@unique([userId, startId])
  @@index([userId, roundId])
  @@index([startId])
  @@index([roundId])
  @@schema("spelvarde")
}

model Source {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  url              String
  enabled          Boolean     @default(true)
  sortOrder        Int         @default(0)
  lastReadAt       DateTime?
  lastStatus       String?
  lastError        String?
  // E5: antal tips (godkända och väntande) från källan i omgången vid senaste läsningen.
  lastFactCount    Int?
  // E5 (10.6): läsaren. NULL = välj efter adressen (lib/tips/collection.ts readerFor).
  kind             SourceKind?
  // E5: relevanta artiklar vid senaste läsningen. NULL = inte läst än.
  lastArticleCount Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tipFacts TipFact[]
  articles TipArticle[]
  tips     Tip[]

  @@unique([userId, url])
  @@schema("spelvarde")
}

// Ersatt av Tip i E5. Tas bort i en senare städmigrering efter Mikaels ja.
// Inga nya läsare eller skrivare får använda den.
model TipFact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  startId   String?
  start     Start?   @relation(fields: [startId], references: [id], onDelete: SetNull)
  horseId   String
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  text      String
  kind      TipKind
  quote     String?
  fetchedAt DateTime @default(now())

  @@index([userId, roundId])
  @@index([sourceId])
  @@index([roundId])
  @@index([startId])
  @@index([horseId])
  @@schema("spelvarde")
}

// En artikel som Hämta tips har hittat för en omgång (per användare, E5 8.4).
model TipArticle {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId        String
  source          Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  roundId         String
  round           Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Normaliserad: https, utan #, utan utm_*-parametrar, utan / sist.
  url             String
  title           String
  publishedAt     DateTime?
  stage           TipStage
  // Brödtexten, högst 60 000 tecken.
  text            String
  // Texten kortades före AI-läsningen.
  truncated       Boolean          @default(false)
  // sha256 hex av den normaliserade texten.
  textHash        String
  interpretedHash String?
  status          TipArticleStatus @default(NEW)
  error           String?
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  interpretedAt   DateTime?
  // Sparade tips och kastade poster vid senaste tolkningen.
  tipCount        Int?
  discarded       Int?

  tips   Tip[]
  usages AiUsage[]

  @@unique([userId, roundId, url])
  @@index([sourceId])
  @@index([roundId])
  @@index([userId, roundId, textHash])
  @@schema("spelvarde")
}

// Ett tips om en häst, tolkat ur en artikel (E5 6.11 och 8.4).
model Tip {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId         String
  source           Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  roundId          String
  round            Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  articleId        String
  article          TipArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // Som AI:n läste texten
  leg              Int?
  number           Int?
  rawHorseName     String
  role             TipRole
  roleWord         String?
  quote            String
  // Kopplingen. startId = null läses som ej kopplat, oavsett match.
  startId          String?
  start            Start?     @relation(fields: [startId], references: [id], onDelete: SetNull)
  horseId          String?
  horse            Horse?     @relation(fields: [horseId], references: [id], onDelete: SetNull)
  match            TipMatch
  // TipFlag-koderna i 6.11.
  flags            String[]
  // "Närmast är …" för NONE (ingen relation, bara id).
  suggestedStartId String?
  // Granskningen
  review           TipReview  @default(PENDING)
  reviewedAt       DateTime?
  editedByUser     Boolean    @default(false)
  // AI:ns koppling och roll, för att visa vad som rättades.
  aiStartId        String?
  aiRole           TipRole
  supersededById   String?
  supersededBy     Tip?       @relation("TipSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       Tip[]      @relation("TipSupersede")
  // Ångra: tillståndet före senaste åtgärden (12, /api/tips/undo).
  undo             Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId, roundId, review])
  @@index([articleId])
  @@index([startId])
  @@index([horseId])
  @@index([sourceId])
  @@index([supersededById])
  @@schema("spelvarde")
}

// Varje anrop till Claude-API:t. Dygnsgränsen räknas här (E5 10.7).
model AiUsage {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId      String?
  round        Round?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  articleId    String?
  article      TipArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  // "TIPS"
  purpose      String
  model        String
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  ok           Boolean     @default(false)
  // Kort orsak, aldrig nyckeln.
  error        String?
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costUsd      Decimal     @default(0) @db.Decimal(10, 6)

  @@index([userId, startedAt])
  @@index([roundId])
  @@index([articleId])
  @@schema("spelvarde")
}

// ---------------------------------------------------------------------------
// Statistikbasen: alla svenska travlopp från ATG (lib/hist.ts). Gemensam
// data, skrivs bara av inläsningen (S10 och cron-jobbet). Används för
// vinst % och plats % per startnummer i stället för travstatistik.se.

// En dag i ATG:s kalender som är inläst. Dagar utan svenska travlopp får
// races = 0, så att de inte läses igen.
model HistDay {
  date       DateTime @id @db.Date
  races      Int
  importedAt DateTime @default(now())

  @@schema("spelvarde")
}

model HistRace {
  // ATG:s lopp-id, t.ex. "2026-10-10_5_1".
  id          String      @id
  date        DateTime    @db.Date
  trackId     Int
  trackName   String
  raceNumber  Int
  // Loppets grunddistans (utan tillägg).
  distance    Int
  startMethod StartMethod
  // Startande (utan strukna).
  starters    Int

  starts HistStart[]

  @@index([startMethod, distance, date])
  @@index([trackId, date])
  @@schema("spelvarde")
}

model HistStart {
  raceId       String
  race         HistRace @relation(fields: [raceId], references: [id], onDelete: Cascade)
  number       Int
  postPosition Int?
  // Distans med tillägg.
  distance     Int
  scratched    Boolean  @default(false)
  // ATG:s placering: 1–3 … eller 0 = oplacerad, null = ingen placering (diskad, struken).
  place        Int?
  disqualified Boolean  @default(false)
  galloped     Boolean  @default(false)
  finalOdds    Decimal? @db.Decimal(6, 2)

  @@id([raceId, number])
  @@schema("spelvarde")
}
