{
  "name": "spelvarde",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:local": "node scripts/local-db.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "check:migration": "vitest run lib/migration-check.test.ts",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "backtest": "vite-node --config vitest.config.ts scripts/backtest.ts --"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^14.2.35",
    "node-html-parser": "^7.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "^5.22.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true
  }
}
